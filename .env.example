# Niemals echte Keys nach GitHub committen.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4
PORT=3000

# Optionaler Zugriffsschutz für die gesamte App.
# Wenn beide Werte gesetzt sind, fragt der Browser nach Benutzername/Passwort.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Express JSON-Limit, z. B. 1mb, 2mb, 5mb.
MAX_REQUEST_BYTES=1mb
