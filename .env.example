# KI-Kernel GPT · Environment-Beispiel
# Niemals echte Keys nach GitHub committen.

# Server
NODE_ENV=production
PORT=3000

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4

# Optionaler Zugriffsschutz für die gesamte App.
# Wenn beide Werte gesetzt sind, fragt der Browser nach Benutzername/Passwort.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Request- und Upload-Grenzen
MAX_REQUEST_BYTES=2mb
MAX_UPLOAD_BYTES=8388608

# Datenbank-Vorbereitung ab App 1.7
# Noch nicht als Hauptspeicher aktiv. Wird zunächst nur vom Healthcheck erkannt.
# Beispiel PostgreSQL/Coolify:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=

# Speicherstrategie für spätere Hybridphase
# local = Browser-LocalStorage bleibt Hauptspeicher
# hybrid = Datenbank zusätzlich nutzen, LocalStorage bleibt Fallback
# db = Datenbank als Hauptspeicher
STORAGE_MODE=local
